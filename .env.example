# Copy this to .env.local and fill in your keys
# .env.local is gitignored and will never be committed

# Primary LLM provider (Google Gemini). Used first for all AI features.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM provider (Groq + Llama 3.3 70B). Automatically used when
# Gemini hits quota (429) or is overloaded (503). Free tier is generous.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — used for the market analysis endpoint
# Leave blank if you don't have these
WOODWIDE_API_KEY=
TOKEN_COMPANY_API_KEY=
